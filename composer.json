{
  "name": "ixbox/phambda",
  "description": "",
  "license": [
    "MIT"
  ],
  "require": {
    "php": "^8.2",
    "php-http/discovery": "^1.17",
    "psr/container": "^2.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/log": "^3.0",
    "psr/http-client-implementation": "^1.0",
    "psr/http-factory-implementation": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Phambda\\": "src"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95.27",
    "laravel/pint": "^1.32.1",
    "mockery/mockery": "^1.6.15",
    "nyholm/psr7": "^1.8.2",
    "pestphp/pest": "^4.7.8 || ^5.3.3",
    "php-http/curl-client": "^2.4",
    "phpstan/phpstan": "^2.3.1",
    "rector/rector": "^2.7"
  },
  "scripts": {
    "analyze": [
      "vendor/bin/phpstan analyse --memory-limit=1G"
    ],
    "test": [
      "vendor/bin/pest"
    ]
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false,
      "pestphp/pest-plugin": true
    }
  }
}
